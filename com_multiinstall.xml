<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
    <name>COM_MULTIINSTALL</name>
    <author>Uziel Almeida Oliveira (Ponto Mega)</author>
    <authorEmail>contato@pontomega.com.br</authorEmail>
    <authorUrl>https://pontomega.com.br</authorUrl>
    <creationDate>2026-11-02</creationDate>
    <copyright>(C) 2010 Chris Taylor, (C) 2012-2026 Uziel Almeida Oliveira (Ponto Mega). All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <version>2.0.0</version>
    <description>COM_MULTIINSTALL_XML_DESCRIPTION</description>
    <namespace path="src">Uzielweb\Component\Multiinstall</namespace>

    <administration>
        <menu link="index.php?option=com_multiinstall">COM_MULTIINSTALL</menu>
        <files folder="admin">
            <folder>language</folder>
            <folder>services</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
            <filename>access.xml</filename>
            <filename>config.xml</filename>
        </files>
    </administration>

    <media destination="com_multiinstall" folder="media/com_multiinstall">
        <folder>css</folder>
        <filename>joomla.asset.json</filename>
    </media>

    <updateservers>
        <server type="extension" name="Multi Install Updates" priority="1">https://raw.githubusercontent.com/uzielweb/Multi_Install/master/update.xml</server>
    </updateservers>
</extension>