    <authorEmail>contato@uzielweb.com.br</authorEmail>
    <authorUrl>https://github.com/uzielweb/Multi_Install</authorUrl>
    <creationDate>2026-11-02</creationDate>
    <copyright>(C) 2010 Chris Taylor, (C) 2026 Uziel Almeida Oliveira. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <version>2.0.0</version>
    <description>COM_MULTIINSTALL_XML_DESCRIPTION</description>
    <namespace path="src">Uzielweb\Component\Multiinstall</namespace>

    <administration>
        <menu link="index.php?option=com_multiinstall">COM_MULTIINSTALL</menu>
        <files folder="admin">
            <folder>language</folder>
            <folder>services</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
            <filename>access.xml</filename>
            <filename>config.xml</filename>
        </files>
    </administration>

    <media destination="com_multiinstall" folder="media/com_multiinstall">
        <folder>css</folder>
        <filename>joomla.asset.json</filename>
    </media>
